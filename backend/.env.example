# ------------------------------------------------------------------
# Server
# ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (use exact origin in production)
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------
# App login (single shared login for every user)
# ------------------------------------------------------------------
APP_USERNAME=admin
APP_PASSWORD=change-me-strong-password
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------
# Zerodha Kite Connect API app credentials
# (from https://developers.kite.trade/apps)
# ------------------------------------------------------------------
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret

# ------------------------------------------------------------------
# Zerodha account credentials — used for the automated daily login.
# ZERODHA_TOTP_SECRET is the base32 secret shown when you enable
# an external authenticator app (NOT the 6-digit code).
# ------------------------------------------------------------------
ZERODHA_USER_ID=AB1234
ZERODHA_PASSWORD=your_zerodha_login_password
ZERODHA_TOTP_SECRET=your_base32_totp_secret

# ------------------------------------------------------------------
# Token refresh scheduler
# ------------------------------------------------------------------
# Every day at 08:00 in the timezone below
TOKEN_REFRESH_CRON=0 8 * * *
TZ=Asia/Kolkata
# Refresh immediately on boot if the stored token is missing/stale
REFRESH_ON_STARTUP=true
# Where the shared access token is persisted
TOKEN_FILE=./data/token.json
